# Copy to .env.local. Do not commit private credentials.
NEXT_PUBLIC_SITE_URL=https://www.your-playnex-domain.com
# Leave false until Shopify, fulfillment, legal pages, real imagery and production QA are approved.
NEXT_PUBLIC_SITE_READY=false
NEXT_PUBLIC_CONTACT_EMAIL=Shivangi@playnexinteractive.com

# Shopify storefront Headless channel credentials
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Shopify collection handles (create these collections, then publish to Headless)
SHOPIFY_ORIGINALS_COLLECTION=playnex-originals
SHOPIFY_DISCOVER_COLLECTION=playnex-discover

# Optional: authenticated contact form delivery using verified sending domain
RESEND_API_KEY=
CONTACT_FROM_EMAIL=PlayNex <hello@your-verified-domain.com>
CONTACT_TO_EMAIL=Shivangi@playnexinteractive.com

# Shopify metaobjects (merchant-editable People / Perspectives)
SHOPIFY_PERSPECTIVES_SECTION_TYPE=playnex_perspectives_section
SHOPIFY_PERSPECTIVES_SECTION_HANDLE=home
SHOPIFY_WEBHOOK_SECRET=
# Optional: hide empty People section until first approved entry is published
NEXT_PUBLIC_HIDE_EMPTY_VOICES=false
